<?xml version="1.0" ?>
<!--
  Door room v1: same wall and rig as v0, two new door kinds.
    Door A (y = -1): GLASS hinged door (aluminium frame + glass pane), lever, hinge on the right (seen from the camera), push.
    Door B (y = +1): SLIDING wooden door on the camera side of the wall, flush pull, slides to the left (seen from the camera).
  Both openings get a door frame trim (part of the wall = background).
  Labels = one id per object (11 door_a, 12 handle_a, 21 door_b, 22 handle_b; 0 = background, max 255).
  door_room_v1.attributes.json maps each id to its object, class (1 door, 2 handle) and attributes.
  Glass pane has visibility_flags 2: a lidar with visibility_mask 4294967293 sees through it (tested).
  Gazebo's depth camera ignores visibility masks, so in depth the glass looks solid (tested 2026-10-29).
  Open: gz topic -t /door_a/cmd_pos -m gz.msgs.Double -p 'data: -1.2'   (radians, -1.6 .. 0)
        gz topic -t /door_b/cmd_pos -m gz.msgs.Double -p 'data: 0.85'   (metres, 0 .. 0.9)
-->
<sdf version="1.9">
  <world name="door_room_v1">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <light type="point" name="ceiling_light">
      <pose>1.5 0 2.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.75 1</diffuse>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.02</quadratic></attenuation>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Back wall at x = 3 (0.1 thick, 2.6 high) with two 0.9 x 2.1 doorways centred at y = -1 and y = +1 -->
    <model name="back_wall">
      <static>true</static>
      <pose>3 0 0 0 0 0</pose>
      <link name="link">
        <collision name="c_left"><pose>0 -2.225 1.3 0 0 0</pose><geometry><box><size>0.1 1.55 2.6</size></box></geometry></collision>
        <visual name="v_left"><pose>0 -2.225 1.3 0 0 0</pose><geometry><box><size>0.1 1.55 2.6</size></box></geometry><material><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
        <collision name="c_mid"><pose>0 0 1.3 0 0 0</pose><geometry><box><size>0.1 1.1 2.6</size></box></geometry></collision>
        <visual name="v_mid"><pose>0 0 1.3 0 0 0</pose><geometry><box><size>0.1 1.1 2.6</size></box></geometry><material><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
        <collision name="c_right"><pose>0 2.225 1.3 0 0 0</pose><geometry><box><size>0.1 1.55 2.6</size></box></geometry></collision>
        <visual name="v_right"><pose>0 2.225 1.3 0 0 0</pose><geometry><box><size>0.1 1.55 2.6</size></box></geometry><material><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
        <collision name="c_lintel_a"><pose>0 -1 2.35 0 0 0</pose><geometry><box><size>0.1 0.9 0.5</size></box></geometry></collision>
        <visual name="v_lintel_a"><pose>0 -1 2.35 0 0 0</pose><geometry><box><size>0.1 0.9 0.5</size></box></geometry><material><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
        <collision name="c_lintel_b"><pose>0 1 2.35 0 0 0</pose><geometry><box><size>0.1 0.9 0.5</size></box></geometry></collision>
        <visual name="v_lintel_b"><pose>0 1 2.35 0 0 0</pose><geometry><box><size>0.1 0.9 0.5</size></box></geometry><material><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
        <visual name="v_trim_a_l"><pose>-0.0575 -1.485 1.05 0 0 0</pose><geometry><box><size>0.015 0.07 2.17</size></box></geometry><material><diffuse>0.95 0.95 0.93 1</diffuse></material></visual>
        <visual name="v_trim_a_r"><pose>-0.0575 -0.515 1.05 0 0 0</pose><geometry><box><size>0.015 0.07 2.17</size></box></geometry><material><diffuse>0.95 0.95 0.93 1</diffuse></material></visual>
        <visual name="v_trim_a_t"><pose>-0.0575 -1.000 2.135 0 0 0</pose><geometry><box><size>0.015 1.04 0.07</size></box></geometry><material><diffuse>0.95 0.95 0.93 1</diffuse></material></visual>
        <visual name="v_trim_b_l"><pose>-0.0575 0.515 1.05 0 0 0</pose><geometry><box><size>0.015 0.07 2.17</size></box></geometry><material><diffuse>0.95 0.95 0.93 1</diffuse></material></visual>
        <visual name="v_trim_b_r"><pose>-0.0575 1.485 1.05 0 0 0</pose><geometry><box><size>0.015 0.07 2.17</size></box></geometry><material><diffuse>0.95 0.95 0.93 1</diffuse></material></visual>
        <visual name="v_trim_b_t"><pose>-0.0575 1.000 2.135 0 0 0</pose><geometry><box><size>0.015 1.04 0.07</size></box></geometry><material><diffuse>0.95 0.95 0.93 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Door A: glass door (aluminium frame + glass pane), lever, hinge right seen from the camera (y = -1.44), push -->
    <model name="door_a">
      <pose>3 -1 0 0 0 0</pose>
      <link name="frame_anchor">
        <inertial><mass>1</mass></inertial>
      </link>
      <joint name="anchor" type="fixed"><parent>world</parent><child>frame_anchor</child></joint>
      <link name="panel">
        <pose>0 0 1.05 0 0 0</pose>
        <inertial>
          <mass>25</mass>
          <inertia><ixx>9.0</ixx><iyy>9.0</iyy><izz>1.6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.04 0.88 2.08</size></box></geometry></collision>
        <visual name="stile_hinge"><pose>0 -0.39 0 0 0 0</pose><geometry><box><size>0.04 0.1 2.08</size></box></geometry><material><diffuse>0.6 0.62 0.65 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
        <visual name="stile_lock"><pose>0 0.39 0 0 0 0</pose><geometry><box><size>0.04 0.1 2.08</size></box></geometry><material><diffuse>0.6 0.62 0.65 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
        <visual name="rail_top"><pose>0 0 0.99 0 0 0</pose><geometry><box><size>0.04 0.68 0.1</size></box></geometry><material><diffuse>0.6 0.62 0.65 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
        <visual name="rail_bottom"><pose>0 0 -0.97 0 0 0</pose><geometry><box><size>0.04 0.68 0.14</size></box></geometry><material><diffuse>0.6 0.62 0.65 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
        <visual name="glass">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><box><size>0.01 0.68 1.84</size></box></geometry>
          <material><diffuse>0.75 0.88 0.92 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
          <transparency>0.85</transparency>
          <visibility_flags>2</visibility_flags>
        </visual>
      </link>
      <joint name="hinge" type="revolute">
        <parent>frame_anchor</parent>
        <child>panel</child>
        <pose>0.02 -0.44 0 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.6</lower><upper>0</upper></limit>
          <dynamics><damping>2.0</damping></dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>hinge</joint_name>
        <topic>/door_a/cmd_pos</topic>
        <p_gain>60</p_gain><i_gain>0.1</i_gain><d_gain>8</d_gain>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>panel</parent_link>
        <child_model>handle_a</child_model>
        <child_link>link</child_link>
      </plugin>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>11</label></plugin>
    </model>

    <!-- handle_a: its own model so the bounding-box camera gives it its own box; held to the door panel by a DetachableJoint -->
    <model name="handle_a">
      <pose>2.95 -0.64 1.0 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="rose">
          <pose>0.02 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.01</length></cylinder></geometry>
          <material><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
        </visual>
        <visual name="lever">
          <pose>-0.01 -0.05 0 0 0 0</pose>
          <geometry><box><size>0.02 0.13 0.02</size></box></geometry>
          <material><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>12</label></plugin>
    </model>

    <!-- Door B: sliding wooden door hung on the camera side of the wall (panel 0.98 wide overlaps the 0.9 opening),
         prismatic joint along +y = slides to the left seen from the camera, 0 .. 0.9 m -->
    <model name="door_b">
      <pose>2.91 1 0 0 0 0</pose>
      <link name="frame_anchor">
        <inertial><mass>1</mass></inertial>
      </link>
      <joint name="anchor" type="fixed"><parent>world</parent><child>frame_anchor</child></joint>
      <link name="panel">
        <pose>0 0 1.06 0 0 0</pose>
        <inertial>
          <mass>20</mass>
          <inertia><ixx>7.5</ixx><iyy>7.2</iyy><izz>1.6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <gravity>false</gravity>
        <collision name="c"><geometry><box><size>0.04 0.98 2.12</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.04 0.98 2.12</size></box></geometry>
          <material><diffuse>0.7 0.55 0.38 1</diffuse></material>
        </visual>
      </link>
      <joint name="slide" type="prismatic">
        <parent>frame_anchor</parent>
        <child>panel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>0</lower><upper>0.9</upper></limit>
          <dynamics><damping>20.0</damping></dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>slide</joint_name>
        <topic>/door_b/cmd_pos</topic>
        <p_gain>200</p_gain><i_gain>0.5</i_gain><d_gain>40</d_gain>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>panel</parent_link>
        <child_model>handle_b</child_model>
        <child_link>link</child_link>
      </plugin>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>21</label></plugin>
    </model>

    <!-- handle_b: flush pull (recessed grip) near the leading edge of the sliding door, on the camera side -->
    <model name="handle_b">
      <pose>2.889 0.6 1.0 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="plate">
          <geometry><box><size>0.002 0.04 0.16</size></box></geometry>
          <material><diffuse>0.2 0.2 0.22 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
        </visual>
        <visual name="grip">
          <pose>-0.0005 0 0 0 0 0</pose>
          <geometry><box><size>0.002 0.025 0.13</size></box></geometry>
          <material><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>22</label></plugin>
    </model>

    <!-- Fixed sensor rig at the origin, 1.2 m high, looking at the wall (+x) -->
    <model name="rig">
      <static>true</static>
      <pose>0 0 1.2 0 0 0</pose>
      <link name="link">
        <sensor name="rgbd" type="rgbd_camera">
          <topic>rgbd</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>12</far></clip>
          </camera>
        </sensor>
        <sensor name="boxes" type="boundingbox_camera">
          <topic>boxes</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <box_type>2d</box_type>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>12</far></clip>
          </camera>
        </sensor>
        <sensor name="boxes3d" type="boundingbox_camera">
          <topic>boxes3d</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <box_type>3d</box_type>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>12</far></clip>
          </camera>
        </sensor>
        <sensor name="seg" type="segmentation_camera">
          <topic>seg</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <segmentation_type>instance</segmentation_type>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>12</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
