    <!-- Fixed sensor rig at the origin, 1.2 m high, looking at the wall (+x) -->
    <model name="rig">
      <static>true</static>
      <pose>0 0 1.2 0 0 0</pose>
      <link name="link">
        <light type="spot" name="headlight">
          <pose>0 0 0.05 0 0 0</pose>
          <cast_shadows>true</cast_shadows>
          <diffuse>0 0 0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <attenuation><range>10</range><constant>0.2</constant><linear>0.05</linear><quadratic>0.02</quadratic></attenuation>
          <direction>1 0 0</direction>
          <spot><inner_angle>0.4</inner_angle><outer_angle>0.8</outer_angle><falloff>1</falloff></spot>
        </light>
        <sensor name="rgbd" type="rgbd_camera">
          <topic>rgbd</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>12</far></clip>
          </camera>
        </sensor>
        <sensor name="boxes" type="boundingbox_camera">
          <topic>boxes</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <box_type>2d</box_type>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>12</far></clip>
          </camera>
        </sensor>
        <sensor name="boxes3d" type="boundingbox_camera">
          <topic>boxes3d</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <box_type>3d</box_type>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>12</far></clip>
          </camera>
        </sensor>
        <sensor name="seg" type="segmentation_camera">
          <topic>seg</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <segmentation_type>instance</segmentation_type>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>12</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

